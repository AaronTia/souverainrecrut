# Copier en .env sur le serveur (jamais commité). Les valeurs réelles viennent
# des variables masquées GitLab CI/CD lors du déploiement.

# Image publiée par Jenkins (tag = version-sha, jamais latest)
DOCKERHUB_USER=aarontiavin
IMAGE_TAG=1.0.0-723d0f4

# Port exposé sur le serveur
BACKEND_PORT=4000

# PostgreSQL
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=souverainrecrut

# API
JWT_SECRET=changez-moi-32-caracteres-minimum
FRONTEND_URL=http://localhost:5173

# Version de la CLI Prisma utilisée pour les migrations (= celle du backend)
PRISMA_VERSION=6.16.2
