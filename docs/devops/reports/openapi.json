{
  "openapi": "3.0.3",
  "info": {
    "title": "SouverainRecrut API",
    "version": "1.0.0",
    "description": "API REST de la plateforme SouverainRecrut développée avec Express, TypeScript, Prisma et PostgreSQL.",
    "contact": {
      "name": "SouverainRecrut",
      "email": "contact@souverainrecrut.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4500/v1",
      "description": "Serveur de développement"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Authentification des utilisateurs"
    },
    {
      "name": "Users",
      "description": "Gestion des utilisateurs"
    },
    {
      "name": "Candidates",
      "description": "Gestion des candidats"
    },
    {
      "name": "Jobs",
      "description": "Gestion des offres d'emploi"
    },
    {
      "name": "Applications",
      "description": "Gestion des candidatures"
    },
    {
      "name": "Dashboard",
      "description": "Statistiques de l'application"
    },
    {
      "name": "Information",
      "description": "Informations générales sur l'API"
    },
    {
      "name": "Health",
      "description": "Surveillance et état de l'API"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authentifier un utilisateur",
        "description": "Permet à un utilisateur de se connecter et de récupérer un token JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "alice@souverainrecrut.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "user": {
                      "id": "cmr0rce840000yws4oao08la7",
                      "firstName": "Alice",
                      "lastName": "Diallo",
                      "email": "alice@souverainrecrut.com",
                      "role": "RECRUITER"
                    },
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Email ou mot de passe invalide."
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Profil de l'utilisateur connecté",
        "description": "Retourne les informations de l'utilisateur authentifié.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil utilisateur.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "id": "cmr0rce840000yws4oao08la7",
                    "firstName": "Alice",
                    "lastName": "Diallo",
                    "email": "alice@souverainrecrut.com",
                    "role": "RECRUITER"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise."
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lister les utilisateurs",
        "description": "Retourne la liste paginée des utilisateurs.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des utilisateurs.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "cmr0rce840000yws4oao08la7",
                      "firstName": "Alice",
                      "lastName": "Diallo",
                      "email": "alice@souverainrecrut.com",
                      "role": "RECRUITER"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise."
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Créer un utilisateur",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "example": "Alice"
                  },
                  "lastName": {
                    "type": "string",
                    "example": "Diallo"
                  },
                  "email": {
                    "type": "string",
                    "example": "alice@souverainrecrut.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "RECRUITER"
                    ],
                    "example": "RECRUITER"
                  }
                },
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "password",
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utilisateur créé."
          },
          "400": {
            "description": "Erreur de validation."
          },
          "409": {
            "description": "Email déjà utilisé."
          }
        }
      }
    },
