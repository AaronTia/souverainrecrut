                    "database": "CONNECTED",
                    "timestamp": "2026-07-01T22:00:00.000Z"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Application non prête.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "data": {
                    "status": "NOT_READY",
                    "database": "DISCONNECTED",
                    "timestamp": "2026-07-01T22:00:00.000Z"
                  }
                }
              }
            }
          }
        }
      }
    }
